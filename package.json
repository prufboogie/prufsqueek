{
  "name": "last-district",
  "version": "0.1.0",
  "private": true,
  "description": "The Last District: a community-built survival game for Squeek holders. Sepolia testnet.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "prisma generate && next build",
    "start": "next start -p 3500",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "tick": "tsx scripts/tick.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.106.1",
    "@types/three": "^0.170.0",
    "framer-motion": "^12.43.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
